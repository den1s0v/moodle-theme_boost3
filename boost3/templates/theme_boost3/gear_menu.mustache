{{!
    @template theme_boost3/gear_menu

    Moodle-3-style consolidated actions menu (Bootstrap dropdown).

    Context variables:
    - title string Accessible label
    - items array of { text, url, active } or { header } or { divider }
}}
<div class="action-menu d-inline theme-boost3-gear">
    <div class="menubar d-flex" role="menubar">
        <div class="action-menu-trigger">
            <div class="dropdown">
                <a
                    href="#"
                    tabindex="0"
                    role="button"
                    id="theme-boost3-gear-btn"
                    class="dropdown-toggle icon-no-margin"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                    title="{{title}}"
                    aria-label="{{title}}"
                >
                    {{! Bootstrap Icons gear-fill (viewBox 0 0 16 16); currentColor is set in post.scss. }}
                    <span class="theme-boost3-gear-icon" aria-hidden="true">
                        <svg class="icon theme-boost3-gear-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" focusable="false">
                            <path fill="currentColor" d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                        </svg>
                    </span>
                </a>
                <div class="dropdown-menu dropdown-menu-right menu" aria-labelledby="theme-boost3-gear-btn">
                    {{#items}}
                        {{#divider}}
                            <div class="dropdown-divider" role="separator"></div>
                        {{/divider}}
                        {{#header}}
                            <h6 class="dropdown-header theme-boost3-gear-group-label">{{header}}</h6>
                        {{/header}}
                        {{^divider}}
                            {{^header}}
                                <a class="dropdown-item {{#active}}active{{/active}}" href="{{url}}" role="menuitem">{{text}}</a>
                            {{/header}}
                        {{/divider}}
                    {{/items}}
                </div>
            </div>
        </div>
    </div>
</div>
