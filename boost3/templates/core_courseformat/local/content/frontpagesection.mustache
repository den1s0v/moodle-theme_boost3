{{!
    @template core_courseformat/local/content/frontpagesection

    theme_boost3 override of the site home section 1 (Moodle 4.5).

    Core renders the "Edit" cog (i/settings) in a <div class="mb-2"> above .sitetopic, i.e. outside
    the section card, right under the page title. Moodle 3.9 Boost showed an "Edit summary" pencil
    inside the section box (course/renderer.php frontpage_section1()). Here the link is moved inside
    the section card (top right) via the section/content block of core_courseformat/local/content/section.
    Context is unchanged (showsettings / settingsurl are looked up from the parent context).

    Example context (json):
    {
        "sections": [
            "<li>This is the section content</li>"
        ],
        "showsettings": true,
        "settingsurl": "#"
    }
}}
<div class="course-content">
    <div class="sitetopic">
        <ul class="topics frontpage">
            {{#sections}}
                {{< core_courseformat/local/content/section }}
                    {{$ core_courseformat/local/content/section/content }}
                        {{#showsettings}}
                        <div class="theme-boost3-sitetopic-edit float-end ms-2">
                            <a href="{{{settingsurl}}}" title="{{#str}} editsummary {{/str}}" aria-label="{{#str}} editsummary {{/str}}">
                                {{#pix}} t/edit, moodle {{/pix}}
                            </a>
                        </div>
                        {{/showsettings}}
                        {{> core_courseformat/local/content/section/content }}
                    {{/ core_courseformat/local/content/section/content }}
                {{/ core_courseformat/local/content/section }}
            {{/sections}}
        </ul>
    </div>
</div>
